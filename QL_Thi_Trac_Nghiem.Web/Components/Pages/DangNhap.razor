@page "/"
@page "/dang-nhap"
@rendermode InteractiveServer
@using QL_Thi_Trac_Nghiem.BUS
@using QL_Thi_Trac_Nghiem.Web.Services
@inject NavigationManager NavManager
@inject PhienDangNhapService PhienDN

<PageTitle>Đăng nhập hệ thống</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="card shadow-sm p-4" style="width: 100%; max-width: 440px;">
        @if (!hienThiDoiMatKhau)
        {
            <h4 class="text-center fw-bold mb-4">ĐĂNG NHẬP</h4>

            @if (!string.IsNullOrEmpty(thongBaoLoi))
            {
                <div class="alert alert-danger py-2" role="alert">
                    @thongBaoLoi
                </div>
            }

            <div class="mb-3 row align-items-center">
                <label class="col-sm-4 col-form-label fw-semibold">Tài khoản:</label>
                <div class="col-sm-8">
                    <input type="text" class="form-control" @bind="taiKhoan" @bind:event="oninput"
                           @onkeydown="XuLyPhimEnter" placeholder="Nhập tài khoản" />
                </div>
            </div>

            <div class="mb-4 row align-items-center">
                <label class="col-sm-4 col-form-label fw-semibold">Mật khẩu:</label>
                <div class="col-sm-8">
                    <input type="password" class="form-control" @bind="matKhau" @bind:event="oninput"
                           @onkeydown="XuLyPhimEnter" placeholder="Nhập mật khẩu" />
                </div>
            </div>

            <div class="d-flex justify-content-center gap-2">
                <button type="button" class="btn btn-primary px-4" @onclick="XuLyDangNhap">
                    Đăng nhập
                </button>
                <button type="button" class="btn btn-outline-secondary px-3" @onclick="MoKhungDoiMatKhau">
                    Đổi mật khẩu
                </button>
            </div>
        }
        else
        {
            <h4 class="text-center fw-bold mb-3">ĐỔI MẬT KHẨU</h4>
            <p class="text-muted small text-center mb-3">
                Mật khẩu mặc định ban đầu là <strong>123456</strong>. Sau khi đổi, mật khẩu mới chỉ lưu cho tài khoản của bạn.
            </p>

            @if (!string.IsNullOrEmpty(thongBaoDoiMK))
            {
                <div class="alert @(doiMKThanhCong ? "alert-success" : "alert-danger") py-2" role="alert">
                    @thongBaoDoiMK
                </div>
            }

            <div class="mb-3">
                <label class="form-label fw-semibold">Tài khoản:</label>
                <input type="text" class="form-control" @bind="taiKhoanDoiMK" @bind:event="oninput"
                       placeholder="Nhập ID tài khoản" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Mật khẩu hiện tại:</label>
                <input type="password" class="form-control" @bind="matKhauHienTai" @bind:event="oninput"
                       placeholder="Nhập mật khẩu hiện tại (mặc định 123456)" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Mật khẩu mới:</label>
                <input type="password" class="form-control" @bind="matKhauMoi" @bind:event="oninput"
                       placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)" />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Nhập lại mật khẩu mới:</label>
                <input type="password" class="form-control" @bind="xacNhanMatKhau" @bind:event="oninput"
                       placeholder="Xác nhận mật khẩu mới" />
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary" @onclick="DongKhungDoiMatKhau">
                    Hủy
                </button>
                <button type="button" class="btn btn-primary" @onclick="XuLyDoiMatKhau">
                    Xác nhận
                </button>
            </div>
        }
    </div>
</div>

@code {
    private readonly TaiKhoanBUS taiKhoanBUS = new TaiKhoanBUS();

    private string taiKhoan = string.Empty;
    private string matKhau = string.Empty;
    private string thongBaoLoi = string.Empty;

    private bool hienThiDoiMatKhau = false;
    private string taiKhoanDoiMK = string.Empty;
    private string matKhauHienTai = string.Empty;
    private string matKhauMoi = string.Empty;
    private string xacNhanMatKhau = string.Empty;
    private string thongBaoDoiMK = string.Empty;
    private bool doiMKThanhCong = false;

    private void XuLyPhimEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            XuLyDangNhap();
        }
    }

    private void XuLyDangNhap()
    {
        thongBaoLoi = string.Empty;

        string tk = taiKhoan.Trim();
        string mk = matKhau.Trim();

        if (string.IsNullOrEmpty(tk) || string.IsNullOrEmpty(mk))
        {
            thongBaoLoi = "Vui lòng nhập đầy đủ Tài khoản và Mật khẩu!";
            return;
        }

        try
        {
            string loaiTaiKhoan = taiKhoanBUS.KiemTraDangNhap(tk, mk)?.Trim() ?? "";

            if (loaiTaiKhoan == "AD")
            {
                PhienDN.DangNhapThanhCong(tk, "AD");
                NavManager.NavigateTo("/admin-nhan-su");
            }
            else if (loaiTaiKhoan == "GV")
            {
                PhienDN.DangNhapThanhCong(tk, "GV");
                NavManager.NavigateTo("/giao-vien");
            }
            else if (loaiTaiKhoan == "TS" || loaiTaiKhoan == "SV")
            {
                PhienDN.DangNhapThanhCong(tk, loaiTaiKhoan);
                NavManager.NavigateTo("/sinh-vien");
            }
            else
            {
                thongBaoLoi = $"Tài khoản hoặc mật khẩu không chính xác! (Quyền trả về: '{loaiTaiKhoan}')";
            }
        }
        catch (Exception ex)
        {
            thongBaoLoi = "Lỗi hệ thống khi đăng nhập: " + ex.Message;
        }
    }

    private void MoKhungDoiMatKhau()
    {
        thongBaoLoi = string.Empty;
        thongBaoDoiMK = string.Empty;
        doiMKThanhCong = false;

        taiKhoanDoiMK = taiKhoan.Trim();
        matKhauHienTai = string.Empty;
        matKhauMoi = string.Empty;
        xacNhanMatKhau = string.Empty;
        hienThiDoiMatKhau = true;
    }

    private void XuLyDoiMatKhau()
    {
        thongBaoDoiMK = string.Empty;
        doiMKThanhCong = false;

        string tk = taiKhoanDoiMK.Trim();
        string mkCu = matKhauHienTai.Trim();
        string mkMoi = matKhauMoi.Trim();
        string mkXacNhan = xacNhanMatKhau.Trim();

        if (string.IsNullOrEmpty(tk))
        {
            thongBaoDoiMK = "Vui lòng nhập ID tài khoản!";
            return;
        }

        if (mkMoi != mkXacNhan)
        {
            thongBaoDoiMK = "Mật khẩu mới và Nhập lại mật khẩu mới không khớp!";
            return;
        }

        try
        {
            doiMKThanhCong = taiKhoanBUS.DoiMatKhau(tk, mkCu, mkMoi, out string thongBao);
            thongBaoDoiMK = thongBao;

            if (doiMKThanhCong)
            {
                taiKhoan = tk;
                matKhau = string.Empty;
                matKhauHienTai = string.Empty;
                matKhauMoi = string.Empty;
                xacNhanMatKhau = string.Empty;
                hienThiDoiMatKhau = false;
                thongBaoLoi = "Đổi mật khẩu thành công. Vui lòng đăng nhập bằng mật khẩu mới.";
            }
        }
        catch (Exception ex)
        {
            thongBaoDoiMK = "Lỗi hệ thống khi đổi mật khẩu: " + ex.Message;
        }
    }

    private void DongKhungDoiMatKhau()
    {
        thongBaoDoiMK = string.Empty;
        matKhauHienTai = string.Empty;
        matKhauMoi = string.Empty;
        xacNhanMatKhau = string.Empty;
        hienThiDoiMatKhau = false;
    }
}


