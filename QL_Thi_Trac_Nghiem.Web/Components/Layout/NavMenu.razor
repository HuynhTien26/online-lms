@implements IDisposable
@using QL_Thi_Trac_Nghiem.Web.Services
@inject PhienDangNhapService PhienDN
@inject NavigationManager NavManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">QL Thi Trắc Nghiệm</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column d-flex flex-column gap-2 p-3">
        @if (PhienDN.DaDangNhap && PhienDN.LaAdmin)
        {
            <button type="button" class="btn btn-light fw-semibold" @onclick="MoQuanLyNhanSu">
                Quản lý Nhân sự
            </button>

            <button type="button" class="btn btn-light fw-semibold" @onclick="MoQuanLyHeThong">
                Quản lý Hệ thống
            </button>

            <button type="button" class="btn btn-light fw-semibold" @onclick="DangXuat">
                Đăng xuất
            </button>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        PhienDN.OnChange += HandleStateChange;
    }

    private void HandleStateChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void MoQuanLyNhanSu() => NavManager.NavigateTo("/admin-nhan-su");
    private void MoQuanLyHeThong() => NavManager.NavigateTo("/giao-vien");

    private void DangXuat()
    {
        PhienDN.DangXuat();
        NavManager.NavigateTo("/");
    }

    public void Dispose()
    {
        PhienDN.OnChange -= HandleStateChange;
    }
}